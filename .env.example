# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_DB=ecopulse
POSTGRES_USER=ecopulse_admin
POSTGRES_PASSWORD=replace-with-a-strong-password

# MinIO
MINIO_ROOT_USER=ecopulse_minio
MINIO_ROOT_PASSWORD=replace-with-a-different-strong-password

# ECOPULSE DATA SOURCES
# Initial monitoring region
ECOPULSE_REGION=Patiala
ECOPULSE_COUNTRY=India

# Approximate Patiala city-centre coordinates
ECOPULSE_LATITUDE=30.3398
ECOPULSE_LONGITUDE=76.3869

# Initial OpenAQ search radius (metres)
ECOPULSE_SEARCH_RADIUS=25000

# OpenAQ
OPENAQ_API_KEY=YOUR_OPENAQ_API_KEY
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Open-Meteo
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast